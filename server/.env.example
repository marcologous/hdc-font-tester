# Port the server listens on
PORT=3000

# Shared password for the admin (add/remove fonts) panel
ADMIN_PASSWORD=change-me

# Long random string used to sign admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-too

# GitHub repo used as font storage. Create a fine-grained Personal Access Token
# with Contents: Read and write access, scoped to this one repo.
GITHUB_TOKEN=github_pat_xxx
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=hdc-font-assets
GITHUB_BRANCH=main
